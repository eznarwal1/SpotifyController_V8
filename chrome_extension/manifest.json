{
  "manifest_version": 3,
  "name": "Universal Media Controller V8.18",
  "version": "0.18.0",
  "description": "Exposes individual Chrome media tabs to the ESP32 media controller.",
  "permissions": [
    "tabs"
  ],
  "host_permissions": [
    "http://127.0.0.1:8765/*",
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "service_worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "Spotify Controller Media Tabs"
  }
}